# Readmissions API — copy to .env and fill in.
# This service is also the single token issuer for both products (/auth/*).

MONGO_URI=mongodb://localhost:27017
MONGO_DB=neuroshield

# Service-level gate ("this caller is our own frontend"), not per-user identity.
# When set, every request needs an X-API-Key header except /healthz and /auth/*.
API_KEY=

# The HS256 signing secret. Holding it means being able to MINT tokens, not
# merely check them — never ship it to a browser bundle or commit it.
# Generate once, with: python3 -c "import secrets; print(secrets.token_hex(32))"
# The same value must be set as SHARED_SECRET_KEY on the GLP-1 API.
SHARED_SECRET_KEY=
SHARED_IDENTITY_DB=shared_identity
SHARED_AUTH_DEFAULT_APPS=glp1,readmissions

# Comma-separated origins allowed to call this API from a browser. Unset means
# "*", which is right locally and wrong once deployed: the API key is compiled
# into the public frontend bundle, so a wildcard lets any page on the internet
# read patient data through a visitor's browser. Include the portal origin —
# it calls /auth/* before anyone has a token.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# AI features: the chatbot, the explanations on patient pages, Model Studio.
# The superadmin chooses the provider and model for each on Settings -> AI, and
# can paste keys there. Keys can also be given here instead; with nothing chosen
# on that page, a GEMINI_API_KEY here serves every feature.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A local model: the address of an Ollama server, e.g. http://ollama:11434
OLLAMA_BASE_URL=

MANUAL_ENTRY_ENABLED=false

# Encrypts secrets stored in the database: hospital database passwords (Data
# page -> Connections) and AI keys pasted on Settings -> AI. Set the SAME value
# on the API and the worker; without it, neither can be saved. Changing it makes
# stored secrets unreadable, so they must be entered again.
# Generate once, with: python3 -c "import secrets; print(secrets.token_hex(32))"
INGEST_SECRET_KEY=

# The worker's clock (ingestion/scheduler.py): when the nightly re-score runs,
# and the default time of a database pull, in the hospital's own time zone.
NIGHTLY_AT=02:00
NIGHTLY_TZ=UTC
