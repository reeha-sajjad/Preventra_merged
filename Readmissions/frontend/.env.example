# Vite reads these at BUILD time. Changing one on a deployed site needs a
# redeploy, not a restart.

VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8001

# Must match API_KEY on the backend. It is compiled into a public bundle, so it
# is a coarse gate that only works alongside a pinned ALLOWED_ORIGINS — treat it
# as "reduces drive-by traffic", not as a secret.
VITE_API_KEY=

# Only hides the UI. The backend refuses those endpoints independently unless
# MANUAL_ENTRY_ENABLED is also true.
VITE_MANUAL_ENTRY_ENABLED=false

# App switcher targets. Both optional: the GLP-1 entry is disabled when its URL
# is absent, and the portal link is hidden.
VITE_GLP1_URL=http://localhost:5173
VITE_PORTAL_URL=http://localhost:5175


